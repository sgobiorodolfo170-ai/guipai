{
  "name": "guipai",
  "version": "1.0.0",
  "description": "龟派 — A股交易洞察桌面应用（Electron + Node.js）",
  "main": "electron/main.js",
  "author": "TradeInsight",
  "license": "private",
  "private": true,
  "scripts": {
    "dev": "node electron/dev-runner.js",
    "build:frontend": "npm --prefix frontend run build",
    "build:akshare-server": "cd python/aktools_server && call build.bat",
    "build": "npm run build:frontend && electron-builder --win",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dolphindb": "^3.1.58",
    "express": "^5.2.1",
    "sql.js": "^1.13.0"
  }
}
